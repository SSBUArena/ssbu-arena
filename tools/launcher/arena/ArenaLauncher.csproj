<Project Sdk="Microsoft.NET.Sdk">
  <!-- SSBU Arena launcher: WPF on .NET Framework 4.8 (in every Windows 10 / 11: nothing to install), one exe.
       dotnet build tools/launcher/arena -c Release   ->   bin/Release/net48/SSBU Arena.exe (setup.py link copies it to build\) -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SSBU Arena</AssemblyName>
    <RootNamespace>Arena</RootNamespace>
    <ApplicationIcon>Assets\arena.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <Product>SSBU Arena</Product>
    <Description>SSBU Arena launcher</Description>
    <Version>0.2.10</Version>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\Fonts\*.ttf" />
    <Resource Include="Assets\arena.ico" />
    <EmbeddedResource Include="Assets\base_save.zip" LogicalName="Arena.base_save.zip" />
    <None Remove="Assets\*.svg" />
    <Reference Include="System.Management" />
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Security" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>
</Project>
