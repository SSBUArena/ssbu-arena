<Application x:Class="Arena.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="OnStartup">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Assets/Art.xaml"/>
      </ResourceDictionary.MergedDictionaries>

      <!-- the site's palette (ssbuarena.com: bg, text, muted, accent, line) -->
      <Color x:Key="BgColor">#0C1119</Color>
      <Color x:Key="AccentColor">#65C7FF</Color>
      <SolidColorBrush x:Key="Bg" Color="#0C1119"/>
      <SolidColorBrush x:Key="BgDeep" Color="#090D14"/>
      <SolidColorBrush x:Key="Card" Color="#0F1620"/>
      <SolidColorBrush x:Key="CardHover" Color="#142030"/>
      <SolidColorBrush x:Key="Field" Color="#0A1018"/>
      <SolidColorBrush x:Key="Text" Color="#EEF3F7"/>
      <SolidColorBrush x:Key="Muted" Color="#91A0B2"/>
      <SolidColorBrush x:Key="Dim" Color="#5D6B7C"/>
      <SolidColorBrush x:Key="Accent" Color="#65C7FF"/>
      <SolidColorBrush x:Key="AccentHover" Color="#8AD5FF"/>
      <SolidColorBrush x:Key="AccentPressed" Color="#4AB4F0"/>
      <SolidColorBrush x:Key="AccentDeep" Color="#1689E8"/>
      <SolidColorBrush x:Key="Line" Color="#233041"/>
      <SolidColorBrush x:Key="LineSoft" Color="#1A2533"/>
      <SolidColorBrush x:Key="Good" Color="#3DDC97"/>
      <SolidColorBrush x:Key="Warn" Color="#FFC857"/>
      <SolidColorBrush x:Key="Bad" Color="#FF6B6B"/>

      <FontFamily x:Key="Body">pack://application:,,,/Assets/Fonts/#Barlow</FontFamily>
      <FontFamily x:Key="Display">pack://application:,,,/Assets/Fonts/#Barlow Condensed</FontFamily>
      <FontFamily x:Key="Condensed">pack://application:,,,/Assets/Fonts/#Barlow Condensed</FontFamily>

      <!-- icons (24 x 24, stroked unless said) -->
      <Geometry x:Key="IcoArrow">M4,12 H19 M13,6 L19,12 L13,18</Geometry>
      <Geometry x:Key="IcoExternal">M14,4 H20 V10 M20,4 L11,13 M18,14 V19 A1,1 0 0 1 17,20 H5 A1,1 0 0 1 4,19 V7 A1,1 0 0 1 5,6 H10</Geometry>
      <Geometry x:Key="IcoPlay">F1 M6,3 L21,12 L6,21 Z</Geometry>
      <Geometry x:Key="IcoSliders">M3,6 H21 M3,12 H21 M3,18 H21 M8,4 V8 M16,10 V14 M10,16 V20</Geometry>
      <Geometry x:Key="IcoCheck">M7,12.5 L10.5,16 L17,9</Geometry>
      <Geometry x:Key="IcoCross">M8,8 L16,16 M16,8 L8,16</Geometry>
      <Geometry x:Key="IcoBang">M12,6.5 V13.5 M12,16.6 V17.4</Geometry>
      <Geometry x:Key="IcoUser">F1 M12,3 A5,5 0 1 1 11.99,3 Z M3,22 C3,16.5 7,14 12,14 C17,14 21,16.5 21,22 Z</Geometry>
      <Geometry x:Key="IcoPad">F1 M7,6 H17 C20.5,6 22.5,9 23,13 L23.6,17 C24,19.5 22.6,21 21,21 C19.7,21 18.9,20.3 18.2,19.2 L16.8,17 H7.2 L5.8,19.2 C5.1,20.3 4.3,21 3,21 C1.4,21 0,19.5 0.4,17 L1,13 C1.5,9 3.5,6 7,6 Z M5.6,9.6 V11.4 H3.8 V13 H5.6 V14.8 H7.2 V13 H9 V11.4 H7.2 V9.6 Z M17.6,9.2 A1.2,1.2 0 1 0 17.61,9.2 Z M15.2,11.8 A1.2,1.2 0 1 0 15.21,11.8 Z M20,11.8 A1.2,1.2 0 1 0 20.01,11.8 Z M17.6,14.2 A1.2,1.2 0 1 0 17.61,14.2 Z</Geometry>
      <Geometry x:Key="IcoFolder">F1 M2,6 C2,4.9 2.9,4 4,4 H9.5 L11.5,6.5 H20 C21.1,6.5 22,7.4 22,8.5 V18 C22,19.1 21.1,20 20,20 H4 C2.9,20 2,19.1 2,18 Z</Geometry>
      <Geometry x:Key="IcoFolderTab">F1 M2,9 H22 V18 C22,19.1 21.1,20 20,20 H4 C2.9,20 2,19.1 2,18 Z</Geometry>
      <Geometry x:Key="IcoPeople">F1 M12,4 A3.4,3.4 0 1 1 11.99,4 Z M5.2,6.4 A2.6,2.6 0 1 1 5.19,6.4 Z M18.8,6.4 A2.6,2.6 0 1 1 18.79,6.4 Z M6.4,21 C6.4,15.8 8.6,12.6 12,12.6 C15.4,12.6 17.6,15.8 17.6,21 Z M0.5,19 C0.5,15 2.4,12.4 5.2,12.4 C6,12.4 6.7,12.6 7.3,13 C6,14.6 5.2,16.6 5,19 Z M23.5,19 C23.5,15 21.6,12.4 18.8,12.4 C18,12.4 17.3,12.6 16.7,13 C18,14.6 18.8,16.6 19,19 Z</Geometry>
      <Geometry x:Key="IcoShield">M12,2 L21,7 V17 L12,22 L3,17 V7 Z</Geometry>
      <Geometry x:Key="IcoChevron">M7.5,9.5 L12,15 L16.5,9.5</Geometry>
      <Geometry x:Key="IcoFilm">M3,5 H21 V19 H3 Z M7,5 V19 M17,5 V19 M3,9 H7 M3,15 H7 M17,9 H21 M17,15 H21</Geometry>
      <Geometry x:Key="IcoCode">M8,7 L3,12 L8,17 M16,7 L21,12 L16,17 M14,4 L10,20</Geometry>
      <Geometry x:Key="IcoTrash">M5,7 H19 M10,7 V4.5 H14 V7 M7,7 L8,20 H16 L17,7 M10.5,11 V16 M13.5,11 V16</Geometry>
      <Geometry x:Key="IcoLock">M7,11 H17 V20 H7 Z M9,11 V8 A3,3 0 0 1 15,8 V11</Geometry>
      <Geometry x:Key="IcoUpload">M12,16 V4 M7,9 L12,4 L17,9 M5,20 H19</Geometry>
      <Geometry x:Key="IcoSearch">M10.5,4 A6.5,6.5 0 1 1 10.49,4 Z M15.5,15.5 L20,20</Geometry>
      <Geometry x:Key="IcoGlobe">M12,3 A9,9 0 1 1 11.99,3 Z M3,12 H21 M12,3 C9,6 9,18 12,21 M12,3 C15,6 15,18 12,21</Geometry>
      <Geometry x:Key="IcoBack">M20,12 H5 M11,6 L5,12 L11,18</Geometry>

      <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Body}"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
      </Style>
      <Style x:Key="Kicker" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Body}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
      </Style>
      <Style x:Key="Small" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Body}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
      </Style>

      <!-- icon path: stroked, the colour from the parent's Foreground -->
      <Style x:Key="Ico" TargetType="Path">
        <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/>
        <Setter Property="StrokeThickness" Value="1.8"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="SnapsToDevicePixels" Value="False"/>
      </Style>

      <!-- the bare button: content only, hand cursor -->
      <Style x:Key="Bare" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="Link" TargetType="Button" BasedOn="{StaticResource Bare}">
        <Setter Property="Foreground" Value="{StaticResource Accent}"/>
        <Setter Property="FontFamily" Value="{StaticResource Body}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentHover}"/></Trigger>
        </Style.Triggers>
      </Style>

      <!-- the big call to action: cut corner bottom-right, like the site's "The project" button -->
      <Style x:Key="Primary" TargetType="Button">
        <Setter Property="Foreground" Value="#06121D"/>
        <Setter Property="Background" Value="{StaticResource Accent}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Grid>
                <Border x:Name="glow" CornerRadius="4" Background="{StaticResource Accent}" Opacity="0">
                  <Border.Effect><BlurEffect Radius="26"/></Border.Effect>
                </Border>
                <Border x:Name="b" CornerRadius="4" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="b" Property="Background" Value="{StaticResource AccentHover}"/>
                  <Setter TargetName="glow" Property="Opacity" Value="0.35"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource AccentPressed}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="b" Property="Background" Value="#2A3B4E"/>
                  <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="Outline" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Background" Value="#660C1119"/>
        <Setter Property="BorderBrush" Value="#3A4A5E"/>
        <Setter Property="FontFamily" Value="{StaticResource Body}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Padding" Value="20,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="b" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
                  <Setter TargetName="b" Property="Background" Value="#1A65C7FF"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- a whole card that is clickable -->
      <Style x:Key="CardButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Background" Value="{StaticResource Card}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="b" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}" ClipToBounds="True">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="b" Property="Background" Value="{StaticResource CardHover}"/>
                  <Setter TargetName="b" Property="BorderBrush" Value="#3B5A78"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="b" CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Foreground" Value="{StaticResource Text}"/>
                  <Setter TargetName="b" Property="Background" Value="#14FFFFFF"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- title bar buttons -->
      <Style x:Key="Caption" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="46"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="b" Background="{TemplateBinding Background}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="b" Property="Background" Value="#1AFFFFFF"/>
                  <Setter Property="Foreground" Value="{StaticResource Text}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="CaptionClose" TargetType="Button" BasedOn="{StaticResource Caption}">
        <Style.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter Property="Background" Value="#E81123"/>
            <Setter Property="Foreground" Value="White"/>
          </Trigger>
        </Style.Triggers>
      </Style>

      <!-- header tabs: a radio button with the accent line under the chosen one -->
      <Style x:Key="NavTab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="FontFamily" Value="{StaticResource Body}"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="GroupName" Value="nav"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="RadioButton">
              <Grid Background="Transparent" MinWidth="96">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="22,0"/>
                <Border x:Name="bar" Height="3" VerticalAlignment="Bottom" Background="{StaticResource Accent}" Opacity="0" CornerRadius="1.5"/>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource Text}"/></Trigger>
                <Trigger Property="IsChecked" Value="True">
                  <Setter Property="Foreground" Value="{StaticResource Text}"/>
                  <Setter Property="FontWeight" Value="SemiBold"/>
                  <Setter TargetName="bar" Property="Opacity" Value="1"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- settings: section list on the left -->
      <Style x:Key="SideTab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="FontFamily" Value="{StaticResource Body}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="GroupName" Value="side"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="RadioButton">
              <Border x:Name="b" Background="Transparent" CornerRadius="5">
                <Grid>
                  <Border x:Name="bar" Width="3" HorizontalAlignment="Left" Margin="0,9" Background="{StaticResource Accent}" Opacity="0" CornerRadius="1.5"/>
                  <ContentPresenter VerticalAlignment="Center" Margin="18,0,12,0"/>
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource Text}"/></Trigger>
                <Trigger Property="IsChecked" Value="True">
                  <Setter Property="Foreground" Value="{StaticResource Text}"/>
                  <Setter TargetName="b" Property="Background" Value="#142030"/>
                  <Setter TargetName="bar" Property="Opacity" Value="1"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- fields -->
      <Style TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Background" Value="{StaticResource Field}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource AccentDeep}"/>
        <Setter Property="FontFamily" Value="{StaticResource Body}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="TextBox">
              <Border x:Name="b" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#3A4A5E"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="PasswordBox">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="Background" Value="{StaticResource Field}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource AccentDeep}"/>
        <Setter Property="FontFamily" Value="{StaticResource Body}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="PasswordBox">
              <Border x:Name="b" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Focusable="False"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#3A4A5E"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- the text part of an editable combo box: no frame of its own -->
      <Style x:Key="BareText" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource AccentDeep}"/>
        <Setter Property="FontFamily" Value="{StaticResource Body}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False"/></ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- on / off switch -->
      <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="FontFamily" Value="{StaticResource Body}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="CheckBox">
              <Grid Background="Transparent">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ContentPresenter VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Border x:Name="track" Grid.Column="1" Width="44" Height="24" CornerRadius="12" Background="#1E2A38" BorderBrush="#33465C" BorderThickness="1" VerticalAlignment="Center">
                  <Ellipse x:Name="knob" Width="16" Height="16" Fill="#91A0B2" HorizontalAlignment="Left" Margin="4,0"/>
                </Border>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="track" Property="Background" Value="{StaticResource Accent}"/>
                  <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource Accent}"/>
                  <Setter TargetName="knob" Property="Fill" Value="#06121D"/>
                  <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- combo box -->
      <Style x:Key="ComboToggle" TargetType="ToggleButton">
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ToggleButton">
              <Border x:Name="b" CornerRadius="4" Background="{StaticResource Field}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                <Path Data="{StaticResource IcoChevron}" Stroke="{StaticResource Muted}" StrokeThickness="1.8" Width="12" Height="8" Stretch="Uniform"
                      HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#3A4A5E"/></Trigger>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="FontFamily" Value="{StaticResource Body}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ComboBox">
              <Grid>
                <ToggleButton Style="{StaticResource ComboToggle}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"/>
                <ContentPresenter x:Name="box" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  Margin="12,0,36,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <TextBox x:Name="PART_EditableTextBox" Style="{StaticResource BareText}" Visibility="Collapsed" Margin="12,0,36,0" Background="Transparent"
                         IsReadOnly="{TemplateBinding IsReadOnly}"/>
                <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                  <Border Margin="0,4,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="280"
                          Background="#111A26" BorderBrush="#2E4057" BorderThickness="1" CornerRadius="4">
                    <ScrollViewer><ItemsPresenter Margin="0,4"/></ScrollViewer>
                  </Border>
                </Popup>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsEditable" Value="True">
                  <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                  <Setter TargetName="box" Property="Visibility" Value="Hidden"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="FontFamily" Value="{StaticResource Body}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ComboBoxItem">
              <Border x:Name="b" Padding="12,8" Background="Transparent">
                <ContentPresenter/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="b" Property="Background" Value="#1C2C3F"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{StaticResource Accent}"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- thin scroll bars -->
      <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8"/>
        <Setter Property="MinWidth" Value="8"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb"><Border CornerRadius="4" Background="#2A3A4D" Margin="1"/></ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <!-- the replay viewer's speed choice (MainWindow.Replays.cs) -->
      <Style x:Key="RvSpeed" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="FontFamily" Value="{StaticResource Condensed}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="RadioButton">
              <Border x:Name="b" CornerRadius="4" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="10,0" Height="32" Margin="0,0,4,0">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource Text}"/></Trigger>
                <Trigger Property="IsChecked" Value="True">
                  <Setter TargetName="b" Property="Background" Value="#1A65C7FF"/>
                  <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
                  <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="Panel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Card}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
      </Style>
      <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Body}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
      </Style>
      <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Display}"/>
        <Setter Property="FontStyle" Value="Italic"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
